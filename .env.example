# ==============================================================================
# FaceLock — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust parameters as needed for your environment.

# Matching & Threshold Settings
FACELOCK_MATCH_THRESHOLD=0.60

# Liveness & Anti-Spoofing Settings
FACELOCK_EAR_THRESHOLD=0.22
FACELOCK_REQUIRED_BLINKS=2
FACELOCK_LIVENESS_TIMEOUT_SECONDS=8.0

# Registration Settings
FACELOCK_SAMPLE_COUNT=15
FACELOCK_MIN_FACE_SIZE=60

# Hardware Settings
FACELOCK_CAMERA_INDEX=0
